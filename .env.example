# --- LLM (Groq free tier) ---
GROQ_API_KEY=

# --- Vector store ---
# Leave QDRANT_URL empty to use embedded local mode at QDRANT_LOCAL_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=.qdrant_local
COLLECTION=arxiv_papers

# --- API ---
# Required header value (X-API-Key) for POST /ingest
INGEST_API_KEY=change-me

# --- Optional overrides ---
# GENERATOR_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=qwen/qwen3.8-27b
# LOG_LEVEL=INFO
# LOG_JSON=false
